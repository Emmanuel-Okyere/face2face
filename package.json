{
  "name": "face2face",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/copy-models.mjs",
    "create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "vercel-build": "node scripts/migrate.mjs && next build",
    "db:status": "node --env-file-if-exists=.env.local scripts/migrate.mjs --status"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.16",
    "next": "16.4.6",
    "nodemailer": "^7.0.13",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
