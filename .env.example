# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: direct/session connection (port 5432) for running migrations.
# Falls back to DATABASE_URL. Migrations run automatically on Vercel production
# deploys via `vercel-build`; set MIGRATE_ON_PREVIEW=1 if previews have their own DB.
# DATABASE_MIGRATION_URL=
# MIGRATE_ON_PREVIEW=

# Random secret ≥ 32 chars, e.g. `openssl rand -base64 48`. Signs sessions, challenges and QR badges.
AUTH_SECRET=

# Vercel Blob (Storage → Blob → create a store, connect it to the project).
# Holds the small face thumbnails as PRIVATE blobs. Leave unset to keep them
# in Postgres instead (fine for local dev). On Vercel, OIDC + BLOB_STORE_ID also works.
BLOB_READ_WRITE_TOKEN=

# ── First admin (seeded ONCE, only while the database has no admins) ─────────
# The password is temporary: it must be changed at first sign-in. After the
# first deploy you can delete these; changing them later has no effect.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ORG_NAME=My organization
# BOOTSTRAP_ORG_SLUG=
# BOOTSTRAP_ORG_TIMEZONE=Africa/Accra

# ── Email (optional) ─────────────────────────────────────────────────────────
# Sends admin invites ("set your password" links) and password resets. Without
# it, new admins get a temporary password typed in by whoever adds them.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# MAIL_FROM="Face2Face <you@gmail.com>"

# ── SMS: GIANT SMS (optional) ────────────────────────────────────────────────
# Event registration confirmations, room/bus notices and announcements.
# Sender ID must be approved in your GIANT SMS dashboard. Use the API token, or
# the account username + password.
# GIANTSMS_SENDER_ID=
# GIANTSMS_TOKEN=
# GIANTSMS_USERNAME=
# GIANTSMS_PASSWORD=

# Recognition tuning (face-api L2 distance; lower = stricter)
MATCH_THRESHOLD=0.5
MATCH_MARGIN=0.05
DUPLICATE_THRESHOLD=0.42


# The deployed origin (https://attendance.example.com). Links in emails use it;
# required for email outside Vercel. Also needed behind a proxy that rewrites Host.
# APP_ORIGIN=
